+.training-phases{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0}.training-phase{padding:16px;border:1px solid var(--border);border-radius:12px;min-width:0;background:var(--surface)}.training-phase.active{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.training-phase.done{background:var(--soft)}.training-phase-plan,.training-once{font-size:12px;color:var(--muted);line-height:1.8}.training-phase-state{display:block;color:var(--accent-strong);font-size:13px;margin:10px 0}.training-phase-detail{font-size:11px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere}.training-phase .raw-values pre{min-width:0}.stage-pick{width:100%;min-height:48px;padding:8px 12px;font-size:14px;line-height:1.5;background:var(--surface)}.stage-pick[aria-pressed=true]{border-color:var(--accent);background:var(--selected)}.condition-explorer{margin-bottom:18px}.condition-tabs{display:flex;gap:10px;margin:20px 0 16px}.condition-tabs button{flex:1;min-height:50px;padding:10px;border:1px solid var(--border);font-size:14px}.condition-tabs button[aria-selected=true]{background:var(--accent);color:var(--button-text);border-color:var(--accent)}.condition-chips{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:18px}.condition-group{border:1px solid var(--border);border-radius:12px;padding:14px;min-width:0}.condition-group.selected-group{border-color:var(--accent);background:var(--soft)}.condition-group h3{font-size:12px;margin-bottom:12px}.chips{display:flex;gap:7px;flex-wrap:wrap}.condition-chip{padding:8px;min-width:60px;min-height:53px;border-radius:9px;font-size:12px;line-height:1.5}.condition-chip small{display:block;font-size:9px;color:var(--muted)}.condition-chip[aria-pressed=true]{border-color:var(--accent);background:var(--selected);box-shadow:inset 0 0 0 1px var(--accent)}.condition-chip[data-status=error]{border-color:var(--error)}.condition-chip[data-status=running]{border-color:var(--accent-strong)}.condition-detail{border:1px solid var(--border);background:var(--soft);border-radius:13px;padding:19px}.condition-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.condition-heading strong{font-size:12px;color:var(--accent-strong)}.condition-detail p{font-size:12px;line-height:1.9;color:var(--muted);overflow-wrap:anywhere}.condition-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:18px 0}.condition-metrics>div{background:var(--surface);padding:15px;border:1px solid var(--border);border-radius:10px;min-width:0}.condition-metrics dt{font-size:11px;color:var(--muted)}.condition-metrics dd{margin:10px 0 0;font-size:18px;overflow-wrap:anywhere}.rounding-note{display:block;color:var(--muted);font-size:10px;line-height:1.6;max-width:180px;margin:6px auto 0}.condition-detail .rounding-notice{color:var(--accent-strong)}.verification-scope{margin-top:17px;font-size:12px;color:var(--muted);line-height:1.9}.verification-scope summary{min-height:44px;padding:10px 0;cursor:pointer;color:var(--text)}.verification-scope summary:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.condition-source{font-size:10px!important}.condition-detail:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
+@media(max-width:1050px){.condition-chips{grid-template-columns:1fr}.condition-group{padding:12px}.condition-chip{min-width:64px}.training-phase{padding:12px}.condition-metrics dd{font-size:16px}}
+@media(max-width:700px){.training-phases{grid-template-columns:1fr}.condition-tabs{gap:6px}.condition-tabs button{font-size:12px}.condition-detail{padding:14px}.condition-metrics{grid-template-columns:1fr}.stage-pick{font-size:14px}.condition-explorer .section-title{align-items:flex-start}}
 /* 원값 펼침은 조작 영역과 긴 십진 문자열을 양쪽 테마에서 유지합니다. */
 .raw-values{text-align:left;font-size:11px;max-width:100%}.raw-values summary{cursor:pointer;min-height:44px;padding:12px 6px;color:var(--accent-strong);list-style-position:inside}.raw-values summary:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:6px}.raw-values pre{height:auto;max-height:280px;min-width:180px;max-width:600px;margin:6px 0;overflow:auto;font-size:11px;overflow-wrap:anywhere}.raw-values p{color:var(--muted);line-height:1.8}.training-panel>.raw-values{margin-top:8px}
 :root{color-scheme:light;--bg:#fff;--sidebar:#f4f7fb;--surface:#fff;--text:#26364a;--muted:#7b8a9e;--accent:#607da2;--accent-strong:#4e6a90;--soft:#edf2f8;--selected:#dfe8f4;--border:#e0e6ed;--shadow:#3451710d;--deep-shadow:#253b6024;--image-frame:#b5c6dc;--image-edge:#829ab9;--image-back:#a2b6d0;--image-caption:#f0f4fa;--film:#121c2b;--terminal:#1c293a;--terminal-text:#d8e5f5;--error:#ad666a;--notice-bg:#fff1e8;--notice-text:#975e3a;--button-text:#fff;--focus:#789ac7;--switch-off:#b0bdce;--switch-thumb:#fff}
