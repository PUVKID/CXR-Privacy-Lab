+        "if($null -eq $p){throw '대상 프로세스 없음'};"
+        "@{pid=[int]$p.ProcessId;parent_pid=[int]$p.ParentProcessId;command_line=[string]$p.CommandLine;"
+        "created_utc=$p.CreationDate.ToUniversalTime().ToString('o')}|ConvertTo-Json -Compress")
