+            with torch.no_grad():
+                self.get_angles(
+                    cosine_of_target_classes
+                )  # For the purpose of collecting stats
+        return cosine_of_target_classes - self.margin
+
+    def scale_logits(self, logits, *_):
+        return logits * self.scale
