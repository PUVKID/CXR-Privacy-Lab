+        raise ValueError("AUC 부트스트랩 표본에 두 클래스가 모두 존재하지 않습니다.")
+    return {
+        "auc_ci_lower": float(np.quantile(results, 0.025)),
+        "auc_ci_upper": float(np.quantile(results, 0.975)),
+        "auc_bootstrap_mean": float(np.mean(results)),
