+                    v.eval()
+                else:
+                    v.train()
+        self.maybe_freeze_trunk_batchnorm()
+
+    def set_to_eval(self):
+        for T in self.trainable_attributes():
+            for v in T.values():
+                v.eval()
+
+    def initialize_loss_weights(self):
+        if self.loss_weights is None:
