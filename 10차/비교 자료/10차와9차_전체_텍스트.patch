+
+        return self._get_accuracy(self.curr_function_dict, **kwargs)
+
+    def _get_accuracy(self, function_dict, **kwargs):
+        return {k: v(**kwargs) for k, v in function_dict.items()}
+
+    def check_primary_metrics(calc, include=(), exclude=()):
