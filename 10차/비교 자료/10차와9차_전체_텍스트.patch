+        if self.collect_stats:
+            with torch.no_grad():
+                self.pos_pair_dist = (
+                    torch.mean(pos_pair).item() if len(pos_pair) > 0 else 0
+                )
+                self.neg_pair_dist = (
+                    torch.mean(neg_pair).item() if len(neg_pair) > 0 else 0
+                )
